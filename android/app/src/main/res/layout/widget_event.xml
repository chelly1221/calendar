<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_event" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:layout_marginBottom="1dp" android:importantForAccessibility="yes">
    <ImageView android:id="@+id/widget_event_color" android:layout_width="1dp" android:layout_height="match_parent"
        android:visibility="gone" android:importantForAccessibility="no" />
    <TextView android:id="@+id/widget_event_title" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:paddingHorizontal="2dp" android:paddingVertical="0.5dp"
        android:singleLine="true" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"
        android:textSize="11sp" android:importantForAccessibility="no" />
</LinearLayout>
