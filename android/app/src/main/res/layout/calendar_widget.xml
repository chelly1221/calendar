<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_round" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="4dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_month" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingStart="6dp" android:textSize="17sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" android:text="달력" />
            <ImageView android:id="@+id/widget_previous" android:layout_width="48dp" android:layout_height="48dp" android:padding="15dp" android:src="@drawable/widget_previous" android:contentDescription="이전 달" />
            <TextView android:id="@+id/widget_today" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="오늘" android:textSize="12sp" android:singleLine="true" android:contentDescription="이번 달로 돌아가기" />
            <ImageView android:id="@+id/widget_next" android:layout_width="48dp" android:layout_height="48dp" android:padding="15dp" android:src="@drawable/widget_next" android:contentDescription="다음 달" />
            <ImageView android:id="@+id/widget_settings" android:layout_width="48dp" android:layout_height="48dp" android:padding="14dp" android:src="@drawable/widget_settings" android:contentDescription="위젯 설정" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_weekdays" android:layout_width="match_parent" android:layout_height="20dp" android:orientation="horizontal" />
        <LinearLayout android:id="@+id/widget_weeks" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" />
        <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center_vertical|end" android:paddingHorizontal="5dp" android:singleLine="true" android:ellipsize="end" android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
